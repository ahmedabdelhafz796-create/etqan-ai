# Gold Trading Analysis Agent — Environment Variables
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# Day-One credentials (§11 MASTER_PLAN)

# 1. Anthropic API — Claude API access
ANTHROPIC_API_KEY=sk-ant-

# 2. Claude Pro — Required for using this development methodology
# (No env var; set in console at claude.ai)

# 3. Market Data Provider — Choose ONE
TWELVE_DATA_API_KEY=demo  # Get from https://twelvedata.com/
ALPHA_VANTAGE_API_KEY=demo  # Get from https://www.alphavantage.co/

# 4. News Provider — Choose ONE or both
NEWSAPI_KEY=demo  # Get from https://newsapi.org/

# 5. Notification — Telegram
TELEGRAM_BOT_TOKEN=  # Get from @BotFather on Telegram
TELEGRAM_CHAT_ID=  # Your Telegram chat ID (numeric)

# 6. GitHub
# (Use git credentials; no env var needed)

# Optional: Database (Phase 2+)
SQLITE_DATABASE_PATH=data/gold_agent.db
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=gold_agent
POSTGRESQL_USER=gold_agent
POSTGRESQL_PASSWORD=

# Optional: Broker Integration (Phase 4+)
MT5_ACCOUNT_NUMBER=
MT5_PASSWORD=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Optional: Email Notifications (Fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_PASSWORD=
SMTP_TO_EMAIL=

# Optional: Webhook Alerts (Fallback)
WEBHOOK_URL=

# Development & Testing
MOCK_DATA_ENABLED=true
OFFLINE_MODE=true
DEBUG_LOGGING=true
